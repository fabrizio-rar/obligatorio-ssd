erDiagram
    direction LR

    users ||--o{ auth_tokens : ""
    users ||--o| carts : ""
    carts ||--o{ cart_items : ""
    products ||--o{ cart_items : ""
    users ||--o{ orders : ""
    orders ||--|{ order_items : ""
    products ||--o{ order_items : ""
    order_items ||--|{ order_item_allocations : ""
    warehouses ||--o{ order_item_allocations : ""
