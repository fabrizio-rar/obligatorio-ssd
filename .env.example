# Copy to .env (`cp .env.example .env`) and fill in the blanks. Never commit .env.

# --- DB ---------------------------------------------------------------------
POSTGRES_DB=mercanova
POSTGRES_USER=mercanova
POSTGRES_PASSWORD=change-me
# Host port to reach Postgres from DBeaver/psql (localhost only; 5433 avoids clashing with a local 5432)
POSTGRES_HOST_PORT=5433
# Connection string used by the backend (host "db" = compose service name)
DATABASE_URL=postgresql+psycopg://mercanova:change-me@db:5432/mercanova
# Separate database for integration tests (created automatically by the test suite)
TEST_DATABASE_URL=postgresql+psycopg://mercanova:change-me@db:5432/mercanova_test

# --- Ingest -----------------------------------------------------------------
# Excel dataset, relative to the backend working dir (/app); ./data is mounted read-only
DATASET_PATH=data/raw/MercaNova_dataset_obligatorio_2.xlsx
# Where the ingest writes its report (./reports is mounted so it is visible on the host)
INGEST_REPORT_PATH=reports/ingest_report.json

# --- Auth -------------------------------------------------------------------
AUTH_TOKEN_TTL_HOURS=72
SEED_DEMO_USER=true

# --- LLM: OpenAI (Responses API) --------------------------------------------
# Required only for the chat; the rest of the app works without it. NEVER commit it.
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
# none | low | medium | high (low for chat: latency and cost)
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
AGENT_MAX_STEPS=6
AGENT_HISTORY_MESSAGES=10
AGENT_TURN_TIMEOUT_SECONDS=90
AGENT_MAX_TOKENS_PER_TURN=12000

# --- Embeddings -------------------------------------------------------------
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024

# --- STT --------------------------------------------------------------------
STT_PROVIDER=faster_whisper
STT_MODEL=small
STT_LANGUAGE=es

# --- Frontend ---------------------------------------------------------------
VITE_API_URL=http://localhost:8000
